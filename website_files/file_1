<!-- ══════════════ JAVASCRIPT ══════════════ -->
<script>
  /* ── State ── */
  const state = {
    reg: {},
    medicines: [],
    discount: 0
  };
 
  /* ── Build medicine rows ── */
  (function buildMedicineRows() {
    const tbody = document.getElementById('medicine-rows');
    for (let i = 1; i <= 12; i++) {
      tbody.innerHTML += `
        <tr>
          <td>${i}</td>
          <td><input type="text" class="med-name" placeholder="Medicine name" /></td>
          <td><input type="text" class="med-qty qty-input" placeholder="Qty" /></td>
        </tr>`;
    }
  })();
 
  /* ── Navigation ── */
  function goTo(n) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.getElementById('page' + n).classList.add('active');
    window.scrollTo({ top: 0, behavior: 'smooth' });
 
    // Update step indicator
    for (let i = 1; i <= 3; i++) {
      const s = document.getElementById('step' + i);
      s.classList.remove('active', 'done');
      if (i < n)  s.classList.add('done');
      if (i === n) s.classList.add('active');
    }
  }
 
  /* ── Helpers ── */
  function showErr(id, msg) {
    const el = document.getElementById('err-' + id);
    const input = document.getElementById(id);
    if (el) { el.textContent = msg || el.textContent; el.classList.add('show'); }
    if (input) input.classList.add('error');
  }
  function clearErr(id) {
    const el = document.getElementById('err-' + id);
    const input = document.getElementById(id);
    if (el) el.classList.remove('show');
    if (input) input.classList.remove('error');
  }
  function val(id) { return (document.getElementById(id)?.value || '').trim(); }
 
  /* ── PAGE 1: Validate Registration ── */
  function validateRegistration() {
    let ok = true;
 
    const fields = ['firstName', 'lastName', 'gender', 'address'];
    fields.forEach(f => {
      clearErr(f);
      if (!val(f)) { showErr(f); ok = false; }
    });
 
    // Phone
    clearErr('phone');
    const phone = val('phone').replace(/\D/g, '');
    if (phone.length < 10) { showErr('phone'); ok = false; }

    // Terms
    clearErr('terms');
    if (!document.getElementById('terms').checked) {
      document.getElementById('err-terms').classList.add('show');
      ok = false;
    }
 
    if (ok) {
      state.reg = {
        firstName: val('firstName'),
        lastName:  val('lastName'),
        gender:    val('gender'),
        phone:     val('phone'),
        address:   val('address')
      };
      goTo(2);
    }
  }
 
  /* ── PAGE 2: Place Order ── */
  function placeOrder() {
    const names = document.querySelectorAll('.med-name');
    const qtys  = document.querySelectorAll('.med-qty');
    const meds  = [];
 
    names.forEach((n, i) => {
      const name = n.value.trim();
      const qty  = qtys[i].value.trim();
      if (name || qty) meds.push({ name: name || '—', qty: qty || '—' });
    });
 
    if (meds.length === 0) {
      alert('Please enter at least one medicine before placing the order.');
      return;
    }
 
    state.medicines = meds;
    state.discount  = parseInt(document.querySelector('input[name="discount"]:checked')?.value || '0');
 console.log("Sending data:", {
  ...state.reg,
  medicines: state.medicines,
  discount: state.discount
});
 fetch("http://localhost/crud/order_details.php", {
  method: "POST",
 headers: { "Content-Type": "application/x-www-form-urlencoded" },
  body: JSON.stringify({
    ...state.reg,
    medicines: state.medicines,
    discount: state.discount
  })
});

    buildSummary();
    goTo(3);
  }
 
  /* ── PAGE 3: Build Summary ── */
  function buildSummary() {
    const r = state.reg;
 
    // Patient
    document.getElementById('summary-patient').innerHTML = `
      <div class="info-item"><div class="info-label">Full Name</div><div class="info-value">${r.firstName} ${r.lastName}</div></div>
      <div class="info-item"><div class="info-label">Gender</div><div class="info-value">${r.gender}</div></div>
      <div class="info-item"><div class="info-label">Phone</div><div class="info-value">${r.phone}</div></div>
      <div class="info-item" style="grid-column:1/-1"><div class="info-label">Address</div><div class="info-value">${r.address}</div></div>
    `;
 
    // Medicines
    const mBody = document.getElementById('summary-medicines');
    mBody.innerHTML = state.medicines.map((m, i) => `
      <tr>
        <td style="color:var(--text-muted);font-size:0.85rem;">${i + 1}</td>
        <td>${m.name}</td>
        <td style="text-align:center;">${m.qty}</td>
      </tr>`).join('');
 
    // Discount
    const discEl = document.getElementById('summary-discount');
    discEl.textContent = state.discount === 0 ? 'No Discount' : `${state.discount}% Discount`;
 
    // Order ID
    document.getElementById('order-id').textContent = 'Order #GMS-' + String(Math.floor(Math.random() * 900000) + 100000);
  }
 
  /* ── New Order ── */
  function newOrder() {
    if (confirm('Order confirmed! Start a new order? This will reset the form.')) {
      location.reload();
    }
  }
 
  // Clear errors on input
  document.querySelectorAll('input, select, textarea').forEach(el => {
    el.addEventListener('input', () => clearErr(el.id));
  });
</script>
 
