 <?php
header("Content-Type: application/json");

// Get JSON data
$data = json_decode(file_get_contents("php://input"), true);

// Connect DB
$conn = new mysqli("localhost", "root", "", "gms_db");

// Check connection
if ($conn->connect_error) {
  die("Connection failed: " . $conn->connect_error);
}

// Extract data
$first = $data['firstName'];
$last  = $data['lastName'];
$gender = $data['gender'];
$phone = $data['phone'];
$address = $data['address'];
$medicines = json_encode($data['medicines']);
$discount = $data['discount'];

// Insert
$sql = "INSERT INTO orders (first_name, last_name, gender, phone, address, medicines, discount)
VALUES ('$first', '$last', '$gender', '$phone', '$address', '$medicines', '$discount')";

if ($conn->query($sql) === TRUE) {
  echo json_encode(["status" => "success"]);
} else {
  echo json_encode(["status" => "error"]);
}

$conn->close();
?>
